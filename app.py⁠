import streamlit as st

st.set_page_config(page_title="Xóc Đĩa Pro", layout="centered")

st.markdown("""
    <style>
    div.stButton > button { width: 100%; height: 80px; font-size: 20px; font-weight: bold; border-radius: 10px; }
    .big-stats { font-size: 35px !important; font-weight: bold; text-align: center; padding: 20px; background-color: #262730; color: white; border-radius: 15px; }
    .recommend { font-size: 40px !important; font-weight: bold; text-align: center; color: #ff4b4b; }
    </style>
""", unsafe_allow_html=True)

st.title("🎯 Xóc Đĩa Pro")

if 'history' not in st.session_state: st.session_state.history = []

cols = st.columns(5)
for i in range(5):
    if cols[i].button(f"{i}"): st.session_state.history.append(i)

if st.session_state.history:
    total = len(st.session_state.history)
    le_count = sum(1 for x in st.session_state.history if x in [1, 3])
    le_pct = (le_count / total) * 100
    chan_pct = 100 - le_pct
    
    st.markdown(f'<p class="big-stats">LẺ: {le_pct:.0f}% | CHẴN: {chan_pct:.0f}%</p>', unsafe_allow_html=True)
    goi_y = "LẺ" if le_pct < chan_pct else "CHẴN"
    st.markdown(f'<p class="recommend">👉 ĐÁNH: {goi_y}</p>', unsafe_allow_html=True)
    st.info("Lịch sử: " + " - ".join([str(x) for x in st.session_state.history[-8:]]))

if st.button("Xóa sạch"):
    st.session_state.history = []
    st.rerun()
